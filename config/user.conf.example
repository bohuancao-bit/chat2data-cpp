# Copy to user.conf and fill in your local settings.
--listen_port=8001
--service_name=UserService
--service_addr=127.0.0.1:8001
--notify_service=NotifyService
--db_service=DatabaseService
--etcd_addr=http://127.0.0.1:2379
--mysql_host=127.0.0.1
--mysql_user=chat2data
--mysql_passwd=CHANGE_ME
--mysql_db=chat2Data
--mysql_port=3306
--mysql_charset=utf8mb4
--redis_host=127.0.0.1
--redis_port=6379
--redis_passwd=
--redis_db=0
--redis_pool_size=16
--log_async=false
--log_level=2
--log_format=[%H:%M:%S][%-7l]: %v
--log_path=stdout
