# Copy to ai.conf and fill in your local settings.
--listen_port=8006
--service_name=AIService
--service_addr=127.0.0.1:8006
--file_service=FileService
--db_service=DatabaseService
--user_service=UserService
--notify_service=NotifyService
--etcd_addr=http://127.0.0.1:2379
--mysql_host=127.0.0.1
--mysql_user=chat2data
--mysql_passwd=CHANGE_ME
--mysql_db=chat2Data
--mysql_port=3306
--mysql_charset=utf8mb4
--redis_host=127.0.0.1
--redis_port=6379
--redis_passwd=
--redis_db=0
--redis_pool_size=16
--temperature=0.7
--max_tokens=2048
--ollama_model_name=CHANGE_ME
--ollama_model_desc=llama模型描述
--ollama_endpoint=http://127.0.0.1:11434
--log_async=false
--log_level=2
--log_format=[%H:%M:%S][%-7l]: %v
--log_path=stdout
