# Copy to database.conf and fill in your local settings.
--listen_port=8005
--service_name=DatabaseService
--service_addr=127.0.0.1:8005
--file_service=FileService
--etcd_addr=http://127.0.0.1:2379
--mysql_host=127.0.0.1
--mysql_user=chat2data
--mysql_passwd=CHANGE_ME
--mysql_db=chat2Data
--mysql_port=3306
--mysql_charset=utf8mb4
--fdfs_trackers=127.0.0.1:22122
--fdfs_connect_timeout=30
--fdfs_network_timeout=30
--log_async=false
--log_level=2
--log_format=[%H:%M:%S][%-7l]: %v
--log_path=stdout
