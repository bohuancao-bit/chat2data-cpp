# Copy to excel.conf and fill in your local settings.
--listen_port=8003
--service_name=ExcelParserService
--service_addr=127.0.0.1:8003
--etcd_addr=http://127.0.0.1:2379
--fdfs_trackers=127.0.0.1:22122
--fdfs_connect_timeout=30
--fdfs_network_timeout=30
--log_async=false
--log_level=2
--log_format=[%H:%M:%S][%-7l]: %v
--log_path=stdout
